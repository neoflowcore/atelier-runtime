{
  "$id": "https://atelier.local/rev51/pilote-approval-effect-operator-intent-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PILOTE_APPROVAL_EFFECT_OPERATOR_INTENT_V1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "INTENT_TYPE": { "const": "PILOTE_APPROVAL_EFFECT_OPERATOR_INTENT_V1" },
    "INTENT_VERSION": { "const": "1.0.0" },
    "CANONICALIZATION_ID": { "const": "ATELIER_EXECUTION_CANONICAL_JSON_V1" },
    "PROJECT_ID": { "type": "string", "minLength": 1 },
    "PHASE_ID": { "type": "string", "minLength": 1 },
    "TASK_ID": { "type": "string", "minLength": 1 },
    "TASK_CONTRACT_SHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "EXECUTION_INTENT_SHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "APPROVAL_MODE": { "enum": ["INHERIT_TASK", "EXPLICIT_HUMAN_APPROVAL", "NO_ADDITIONAL_APPROVAL"] },
    "EFFECT_CLASS_REFS": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
      "uniqueItems": true
    },
    "SCOPE_REFS": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$" },
      "uniqueItems": true
    },
    "REMOTE_MUTATION_INTENT": { "enum": ["NONE", "DECLARED", "EXACT_APPROVAL_REQUIRED"] },
    "HOST_OPERATION_INTENT": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
    "OPERATOR_POLICY": { "enum": ["ZERO_TOUCH_AFTER_APPROVAL", "RECOVERY_INTERACTION_ALLOWED"] },
    "INTERVENTION_POLICY": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,63}$" },
    "INTERVENTION_POLICY_REF": { "const": "task-contract:INTERVENTION_POLICY" },
    "AUTHORITY_GRANT_POLICY": { "const": "DECLARATION_NEVER_GRANTS_AUTHORITY" },
    "FIRST_IRREVERSIBLE_REMOTE_SUBMISSION_POLICY": { "const": "ATOMIC_APPROVAL_CLAIM_REQUIRED" },
    "OUTCOME_UNKNOWN_APPROVAL_POLICY": { "const": "SAME_OPERATION_RECONCILE_APPROVAL_REOPEN_DENY" },
    "NORMAL_PATH_POLICY": { "const": "ZERO_TOUCH_AFTER_APPROVAL" },
    "STATE_AFFECTING_INTERVENTION_POLICY": { "const": "TRUST_RESET_REQUIRED" },
    "OBSERVE_ONLY_INTERVENTION_POLICY": { "const": "TRUST_PRESERVED" },
    "CONTRACT_SET_REF": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ID": { "const": "ATELIER_REV51_CONTRACT_SET_V1" },
        "VERSION": { "const": "1.0.0" },
        "SHA256": { "const": "a8b220c92a47306061e9aca1c65077d357b00bda12e9daad4f37215256083f4a" }
      },
      "required": ["ID", "VERSION", "SHA256"]
    },
    "A4_INTENT_SHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "required": [
    "INTENT_TYPE",
    "INTENT_VERSION",
    "CANONICALIZATION_ID",
    "PROJECT_ID",
    "PHASE_ID",
    "TASK_ID",
    "TASK_CONTRACT_SHA256",
    "EXECUTION_INTENT_SHA256",
    "APPROVAL_MODE",
    "EFFECT_CLASS_REFS",
    "SCOPE_REFS",
    "REMOTE_MUTATION_INTENT",
    "HOST_OPERATION_INTENT",
    "OPERATOR_POLICY",
    "INTERVENTION_POLICY",
    "INTERVENTION_POLICY_REF",
    "AUTHORITY_GRANT_POLICY",
    "FIRST_IRREVERSIBLE_REMOTE_SUBMISSION_POLICY",
    "OUTCOME_UNKNOWN_APPROVAL_POLICY",
    "NORMAL_PATH_POLICY",
    "STATE_AFFECTING_INTERVENTION_POLICY",
    "OBSERVE_ONLY_INTERVENTION_POLICY",
    "CONTRACT_SET_REF",
    "A4_INTENT_SHA256"
  ]
}
