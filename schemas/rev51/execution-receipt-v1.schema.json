{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atelier.local/schemas/rev51/execution-receipt-v1.schema.json",
  "title": "EXECUTION_RECEIPT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SCHEMA_ID",
    "SCHEMA_VERSION",
    "CANONICALIZATION_ID",
    "UPSTREAM_OBJECT_SHA256",
    "OBJECT_SHA256",
    "WORKER_JOB_HASH",
    "EXECUTION_PLAN_HASH",
    "EXECUTION_ID",
    "ATTEMPT_ID",
    "FENCE_TOKEN",
    "VERIFICATION_RESULT",
    "RUNTIME_SEALED",
    "ACCEPTED_ARTIFACT_IDS"
  ],
  "properties": {
    "SCHEMA_ID": {
      "const": "EXECUTION_RECEIPT_V1"
    },
    "SCHEMA_VERSION": {
      "const": "1"
    },
    "CANONICALIZATION_ID": {
      "const": "ATELIER_REV51_JCS_V1"
    },
    "UPSTREAM_OBJECT_SHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "OBJECT_SHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "WORKER_JOB_HASH": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "EXECUTION_PLAN_HASH": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "EXECUTION_ID": {
      "type": "string",
      "minLength": 1
    },
    "ATTEMPT_ID": {
      "type": "string",
      "minLength": 1
    },
    "FENCE_TOKEN": {
      "type": "string",
      "minLength": 1
    },
    "VERIFICATION_RESULT": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "RUNTIME_SEALED": {
      "const": true
    },
    "ACCEPTED_ARTIFACT_IDS": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
