{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atelier.local/schemas/runtime-e-credential-grant.schema.json",
  "title": "Runtime E Credential Grant V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["grant_type","credential_ref","credential_material","purpose","allowed_hosts","allowed_operations","issued_at_ms","expires_at_ms","authority_evidence_sha256"],
  "properties": {
    "grant_type": {"const":"RUNTIME_E_CREDENTIAL_GRANT_V1"},
    "credential_ref": {"type":"string","minLength":1},
    "credential_material": {"type":"null"},
    "purpose": {"enum":["PROVIDER_ADMIN_READ","PROVIDER_ADMIN_WRITE","PRODUCTION_READBACK"]},
    "allowed_hosts": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3}},
    "allowed_operations": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["GET_POLICY","PUT_RULESET","PUT_BRANCH_PROTECTION","GET_PRODUCTION_STATE"]}},
    "issued_at_ms": {"type":"integer","minimum":0},
    "expires_at_ms": {"type":"integer","minimum":1},
    "authority_evidence_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
