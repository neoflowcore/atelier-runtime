{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atelier.local/schemas/runtime-b-seal.schema.json",
  "title": "Atelier Runtime B Seal Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "interface_version",
    "interface_manifest_sha256",
    "task_contract_schema_sha256",
    "task_contract_machine_schema_sha256",
    "baseline_epoch_id",
    "runtime_b_candidate_sha",
    "runtime_b_candidate_tree",
    "runtime_b_snapshot_sha256",
    "runtime_b_implementation",
    "runtime_b_sealed",
    "seal_decision",
    "pilote_rev45_final_seal_dependency",
    "sync_3",
    "live_self_hosted_invocation",
    "authority_semantics",
    "lease_state",
    "validation_execution_source_write",
    "remote_source_write_authority",
    "result",
    "reasons"
  ],
  "properties": {
    "receipt_type": { "const": "RUNTIME_B_SEAL_RECEIPT_V1" },
    "interface_version": { "const": "1.0.0" },
    "interface_manifest_sha256": { "const": "90b016211babd4f10b7de7700c54ea6e2db9179563d88502fc1d9983ad47b617" },
    "task_contract_schema_sha256": { "const": "6afcf7aa1b7d3d73b28d6195326db22c82774de308664ce85ba52e42fba640e8" },
    "task_contract_machine_schema_sha256": { "const": "3bdbb85a7879c8cee2c7eb2f18c3936fac7a44389ec0ae61f0954b9c19660b65" },
    "baseline_epoch_id": { "const": "11cfb57b2cd0f4d36e6c064ee908ab198677d5309529c2054829cc9da7f103a3" },
    "runtime_b_candidate_sha": { "$ref": "#/$defs/sha40" },
    "runtime_b_candidate_tree": { "$ref": "#/$defs/sha40" },
    "runtime_b_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_b_implementation": { "enum": ["COMPLETE", "BLOCKED"] },
    "runtime_b_sealed": { "enum": ["NO", "YES"] },
    "seal_decision": { "enum": ["PENDING_FINAL_GATE", "SEALED"] },
    "pilote_rev45_final_seal_dependency": { "const": "NONE_FOR_RUNTIME_B_IMPLEMENTATION" },
    "sync_3": { "const": "NOT_EVALUATED" },
    "live_self_hosted_invocation": { "const": "NOT_RUN" },
    "authority_semantics": { "const": "OPAQUE_EXTERNAL_EVIDENCE_ONLY" },
    "lease_state": { "const": "NOT_IMPLEMENTED_PLAN_D" },
    "validation_execution_source_write": { "const": 0 },
    "remote_source_write_authority": { "const": "NONE" },
    "result": { "enum": ["PASS", "BLOCKED"] },
    "reasons": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
